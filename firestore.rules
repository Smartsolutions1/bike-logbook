rules_version = '2';

// Bike Logbook security rules.
// - Every bike has an owner. The owner can share it with up to 3 groups (e.g. "Family").
// - People in a group can see the group's bikes and add entries to them.
// - Only the owner can change a bike's settings, share/unshare it, or delete it.
// - People join a group with the invite code from the owner's invite link.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function groupDoc(gid) { return get(/databases/$(database)/documents/groups/$(gid)); }
    function isGroupMember(gid) {
      return exists(/databases/$(database)/documents/groups/$(gid)/members/$(me()));
    }
    function inGroup(gs, i) { return gs.size() > i && isGroupMember(gs[i]); }
    function sharedWithMe(gs) {
      return gs is list && (inGroup(gs, 0) || inGroup(gs, 1) || inGroup(gs, 2));
    }
    function canAccess(b) {
      return b.ownerId == me() || sharedWithMe(b.get('groups', []));
    }
    function validGroups(b) {
      let gs = b.get('groups', []);
      return gs is list && gs.size() <= 3
        && (gs.size() < 1 || isGroupMember(gs[0]))
        && (gs.size() < 2 || isGroupMember(gs[1]))
        && (gs.size() < 3 || isGroupMember(gs[2]));
    }

    // Public display names (so family members see who added an entry),
    // plus the list of groups the person has joined.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid;
      // Phones where this person turned on reminders. Private to them; the daily reminder job reads them with admin access.
      match /devices/{deviceId} {
        allow read, write: if signedIn() && me() == uid;
      }
    }

    // A short summary of each bike (last oil change, tuning, odometer, km per day) for the daily reminder job.
    // Anyone who can see the bike can update it, so family members' entries count too.
    match /bikeStats/{bikeId} {
      function statsBike() { return get(/databases/$(database)/documents/bikes/$(bikeId)).data; }
      allow read, write: if signedIn() && exists(/databases/$(database)/documents/bikes/$(bikeId)) && canAccess(statsBike());
    }

    // Mechanics and parts shops. Any signed-in person can look a shop up (from its QR code); only its owner changes it.
    match /shops/{sid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == me();
      allow update: if signedIn() && resource.data.ownerId == me() && request.resource.data.ownerId == me();
      allow delete: if signedIn() && resource.data.ownerId == me();

      // Bikes whose owners let this shop add jobs (copied here by the bike's owner so the shop can list them).
      match /customers/{bikeId} {
        function custBike() { return get(/databases/$(database)/documents/bikes/$(bikeId)).data; }
        allow read: if signedIn() && (get(/databases/$(database)/documents/shops/$(sid)).data.ownerId == me()
          || resource.data.ownerId == me());
        allow create, update: if signedIn() && request.resource.data.ownerId == me()
          && exists(/databases/$(database)/documents/bikes/$(bikeId))
          && custBike().ownerId == me()
          && exists(/databases/$(database)/documents/bikes/$(bikeId)/links/$(sid));
        allow delete: if signedIn() && (resource.data.ownerId == me()
          || get(/databases/$(database)/documents/shops/$(sid)).data.ownerId == me());
      }
    }

    match /groups/{gid} {
      allow read: if signedIn() && (resource.data.ownerId == me() || isGroupMember(gid));
      allow create: if signedIn() && request.resource.data.ownerId == me();
      allow update: if signedIn() && (
        (resource.data.ownerId == me() && request.resource.data.ownerId == me())
        || (isGroupMember(gid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bikeIds'])));
      allow delete: if signedIn() && resource.data.ownerId == me();

      match /members/{uid} {
        allow read: if signedIn() && (groupDoc(gid).data.ownerId == me() || isGroupMember(gid));
        allow create: if signedIn() && uid == me() && request.resource.data.uid == me()
          && (groupDoc(gid).data.ownerId == me()
              || request.resource.data.code == groupDoc(gid).data.inviteCode);
        allow delete: if signedIn() && (uid == me() || groupDoc(gid).data.ownerId == me());
      }
    }

    // Lets a person find the groups they belong to.
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && resource.data.uid == me();
    }

    match /bikes/{bikeId} {
      allow read: if signedIn() && canAccess(resource.data);
      allow create: if signedIn() && request.resource.data.ownerId == me()
        && validGroups(request.resource.data);
      allow update: if signedIn() && resource.data.ownerId == me()
        && request.resource.data.ownerId == me() && validGroups(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerId == me();

      // Shops the bike's owner allowed to add jobs to this bike
      match /links/{sid} {
        function linkBike() { return get(/databases/$(database)/documents/bikes/$(bikeId)).data; }
        allow read: if signedIn() && (canAccess(linkBike())
          || get(/databases/$(database)/documents/shops/$(sid)).data.ownerId == me());
        allow write: if signedIn() && linkBike().ownerId == me()
          && exists(/databases/$(database)/documents/shops/$(sid));
      }

      match /entries/{eid} {
        function bike() { return get(/databases/$(database)/documents/bikes/$(bikeId)).data; }
        // A job added by a shop the bike's owner linked (4.2): only that shop's owner, while the link exists.
        function shopJob(d) {
          return d.get('shopId', '') is string && d.get('shopId', '') != ''
            && exists(/databases/$(database)/documents/bikes/$(bikeId)/links/$(d.shopId))
            && get(/databases/$(database)/documents/shops/$(d.shopId)).data.ownerId == me();
        }
        allow read: if signedIn() && (canAccess(bike()) || shopJob(resource.data));
        allow create: if signedIn() && request.resource.data.addedBy == me()
          && (canAccess(bike()) || shopJob(request.resource.data));
        // The shop may correct or delete only the jobs it added itself.
        allow update: if signedIn() && resource.data.addedBy == me() && request.resource.data.addedBy == me()
          && request.resource.data.get('shopId', '') == resource.data.get('shopId', '')
          && shopJob(resource.data);
        // Deleting is a soft delete (kept for restoring). Only the bike's owner or the
        // entry's author may delete; anyone with access may edit or restore.
        allow update: if signedIn() && canAccess(bike())
          && request.resource.data.addedBy == resource.data.addedBy
          && (!(request.resource.data.get('deleted', false) == true && resource.data.get('deleted', false) != true)
              || bike().ownerId == me() || resource.data.addedBy == me());
        allow delete: if signedIn() && (bike().ownerId == me() || resource.data.addedBy == me());
      }
    }
  }
}
